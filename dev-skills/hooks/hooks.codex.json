{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|shell|apply_patch|spawn_agent|Agent|^request_user_input(_async)?$|^mcp__([0-9a-f]{12}__)?t3_code(_direct)?__(read_issue|pull_request_read|t3_pending_request|t3_thread_read|t3_thread_organize|delegate_task|create_threads|t3_thread_launch|t3_thread_list|list_issues)$",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${PLUGIN_ROOT}/scripts/t3_project_lead_hook.py\" ] || exit 0; python3 \"${PLUGIN_ROOT}/scripts/t3_project_lead_hook.py\" --host codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${PLUGIN_ROOT}/scripts/t3_project_lead_hook.py\" ] || exit 0; python3 \"${PLUGIN_ROOT}/scripts/t3_project_lead_hook.py\" --host codex"
          }
        ]
      }
    ]
  }
}
