{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|exec_command|shell|apply_patch|spawn_agent|Agent|mcp__t3_code__read_issue|mcp__t3_code__pull_request_read|mcp__t3_code_direct__read_issue|mcp__t3_code_direct__pull_request_read",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${PLUGIN_ROOT}/scripts/t3_project_lead_hook.py\" ] || exit 0; python3 \"${PLUGIN_ROOT}/scripts/t3_project_lead_hook.py\" --host codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${PLUGIN_ROOT}/scripts/t3_project_lead_hook.py\" ] || exit 0; python3 \"${PLUGIN_ROOT}/scripts/t3_project_lead_hook.py\" --host codex"
          }
        ]
      }
    ]
  }
}
