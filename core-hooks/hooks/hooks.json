{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${CORE_HOOKS_STALE_CHECK:-}\" = 1 ] || exit 0; uv run --no-project ${CLAUDE_PLUGIN_ROOT}/scripts/stale_install_check.py || exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project ${CLAUDE_PLUGIN_ROOT}/scripts/safety_guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project ${CLAUDE_PLUGIN_ROOT}/scripts/pre_git_hook.py"
          },
          {
            "type": "command",
            "command": "uv run --no-project ${CLAUDE_PLUGIN_ROOT}/scripts/zsh_traps.py --host claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project ${CLAUDE_PLUGIN_ROOT}/scripts/post_tool_use.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project ${CLAUDE_PLUGIN_ROOT}/scripts/system_notification.py --success"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project ${CLAUDE_PLUGIN_ROOT}/scripts/system_notification.py --success"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project ${CLAUDE_PLUGIN_ROOT}/scripts/system_notification.py --success"
          }
        ]
      }
    ]
  }
}
